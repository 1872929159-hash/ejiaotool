  "rules": [
    {
      "rule_id": "LAW-ADV",
      "rule_type": "legal",
      "title": "中华人民共和国广告法",
      "subtitle": "2018年修订版",
      "issuer": "全国人民代表大会常务委员会",
      "effective_date": "2018-10-26",
      "expire_date": null,
      "status": "effective",
      "source_url": "http://www.npc.gov.cn/npc/c30834/201808/f9a7782bd2a04ac0a6c19d4cf9ab265f.shtml",
      "chapters": [
        {
          "chapter_id": "ch03",
          "chapter_title": "第三章 广告行为规范",
          "sections": [
            {
              "section_id": "ch03-s09",
              "article_number": "第九条",
              "article_title": "广告禁止情形",
              "content": "广告不得有下列情形：(一)使用或者变相使用中华人民共和国的国旗、国歌、国徽，军旗、军歌、军徽；(二)使用或者变相使用国家机关、国家机关工作人员的名义或者形象；(三)使用'国家级'、'最高级'、'最佳'等用语；(四)损害国家的尊严或者利益，泄露国家秘密；(五)妨碍社会公共秩序或者违背社会良好风尚；(六)含有淫秽、色情、赌博、迷信、恐怖、暴力的内容；(七)含有民族、种族、宗教、性别歧视的内容；(八)妨碍环境、自然资源或者文化遗产保护；(九)法律、行政法规规定禁止的其他情形。",
              "sub_items": [
                {
                  "item_id": "ch03-s09-i03",
                  "item_label": "(三)",
                  "content": "使用'国家级'、'最高级'、'最佳'等用语",
                  "related_lexicon_categories": ["ADV-ABS", "ADV-EXT", "ADV-LVL", "ADV-ONE"]
                },
                {
                  "item_id": "ch03-s09-i06",
                  "item_label": "(六)",
                  "content": "含有淫秽、色情、赌博、迷信、恐怖、暴力的内容",
                  "related_lexicon_categories": ["FPM-SUP"]
                }
              ],
              "penalty_reference": "第五十八条",
              "related_lexicon_categories": ["ADV"]
            },
            {
              "section_id": "ch03-s17",
              "article_number": "第十七条",
              "article_title": "非医疗广告禁止涉及疾病治疗功能",
              "content": "除医疗、药品、医疗器械广告外，禁止其他任何广告涉及疾病治疗功能。药品、医疗器械广告不得有下列内容：(一)表示功效、安全性的断言或者保证；(二)说明治愈率或者有效率；(三)与其他药品、医疗器械的功效和安全性或者其他医疗机构比较；(四)利用广告代言人作推荐、证明；(五)法律、行政法规规定禁止的其他内容。",
              "sub_items": [
                {
                  "item_id": "ch03-s17-i01",
                  "item_label": "第一款",
                  "content": "除医疗、药品、医疗器械广告外，禁止其他任何广告涉及疾病治疗功能",
                  "related_lexicon_categories": ["EFF-MED", "FMD-DIS", "FMD-MED"]
                }
              ],
              "penalty_reference": "第五十八条",
              "related_lexicon_categories": ["EFF-MED", "FMD"]
            },
            {
              "section_id": "ch03-s18",
              "article_number": "第十八条",
              "article_title": "保健食品广告规范",
              "content": "保健食品广告不得含有下列内容：(一)表示功效、安全性的断言或者保证；(二)涉及疾病预防、治疗功能；(三)声称或者暗示广告商品为保障健康所必需；(四)与药品、其他保健食品进行比较；(五)利用广告代言人作推荐、证明；(六)利用科研单位、学术机构、医疗机构、行业协会、专业人士、消费者的名义或者形象作推荐、证明。保健食品广告应当显著标明'本品不能代替药物'。",
              "sub_items": [
                {
                  "item_id": "ch03-s18-i01",
                  "item_label": "第一款第(一)项",
                  "content": "保健食品广告不得含有表示功效、安全性的断言或者保证",
                  "related_lexicon_categories": ["EFF-IMM", "EFF-BLD"]
                },
                {
                  "item_id": "ch03-s18-i02",
                  "item_label": "第一款第(二)项",
                  "content": "保健食品广告不得涉及疾病预防、治疗功能",
                  "related_lexicon_categories": ["EFF-MED", "FMD-DIS"]
                },
                {
                  "item_id": "ch03-s18-warn",
                  "item_label": "第二款",
                  "content": "保健食品广告应当显著标明'本品不能代替药物'",
                  "related_lexicon_categories": ["EFF-IMM"]
                }
              ],
              "penalty_reference": "第五十八条",
              "related_lexicon_categories": ["EFF"]
            },
            {
              "section_id": "ch03-s25",
              "article_number": "第二十五条",
              "article_title": "招商等广告禁止保证性承诺",
              "content": "招商等有投资回报预期的商品或者服务广告，应当对投资回报率或者收益等情况作出客观分析，合理提示风险，不得含有下列内容：(一)对未来效果、收益或者与其相关的情况作出保证性承诺，明示或者暗示保本、无风险或者保收益等；(二)利用学术机构、行业协会、专业人士、受益者的名义或者形象作推荐、证明。",
              "penalty_reference": "第五十八条",
              "related_lexicon_categories": ["FPM-FRD"]
            },
            {
              "section_id": "ch03-s28",
              "article_number": "第二十八条",
              "article_title": "虚假广告",
              "content": "广告以虚假或者引人误解的内容欺骗、误导消费者的，构成虚假广告。广告有下列情形之一的，为虚假广告：(一)商品或者服务不存在的；(二)商品的性能、功能、产地、用途、质量、规格、成分、价格、生产者、有效期限、销售状况、曾获荣誉等信息，以及与商品或者服务有关的允诺等信息与实际情况不符的；(三)使用虚构、伪造或者无法验证的科研成果、统计资料、调查结果、文摘、引用语等信息作证明材料的；(四)虚构使用商品或者接受服务的效果的。",
              "penalty_reference": "第五十五条",
              "related_lexicon_categories": ["ADV", "EJ", "PLT-QUA", "PLT-DAT"]
            }
          ]
        }
      ],
      "penalty_summary": "违反第九条的广告，由市场监督管理部门责令停止发布广告，对广告主处二十万元以上一百万元以下的罚款；违反第十七条、第十八条的，处广告费用三倍以上五倍以下的罚款，广告费用无法计算或明显偏低的处二十万元以上一百万元以下的罚款；情节严重的可吊销营业执照。",
      "tags": ["广告法", "绝对化用语", "极限词", "功效宣称", "保健食品", "虚假广告"],
      "version": "1.0.0",
      "created_at": "2026-07-30T00:00:00Z",
      "updated_at": "2026-07-30T00:00:00Z"
    },
    {
      "rule_id": "LAW-FOOD",
      "rule_type": "legal",
      "title": "中华人民共和国食品安全法",
      "subtitle": "2021年修订版",
      "issuer": "全国人民代表大会常务委员会",
      "effective_date": "2021-04-29",
      "expire_date": null,
      "status": "effective",
      "source_url": "http://www.npc.gov.cn/",
      "chapters": [
        {
          "chapter_id": "ch06",
          "chapter_title": "第六章 食品进出口与广告",
          "sections": [
            {
              "section_id": "ch06-s73",
              "article_number": "第七十三条",
              "article_title": "食品广告规范",
              "content": "食品广告的内容应当真实合法，不得含有虚假内容，不得涉及疾病预防、治疗功能。食品生产经营者对食品广告内容的真实性、合法性负责。县级以上人民政府食品安全监督管理部门和其他有关部门以及食品检验机构、食品行业协会不得以广告或者其他形式向消费者推荐食品。消费者组织不得以收取费用或者其他牟取利益的方式向消费者推荐食品。",
              "sub_items": [
                {
                  "item_id": "ch06-s73-i01",
                  "item_label": "第一款",
                  "content": "食品广告不得涉及疾病预防、治疗功能",
                  "related_lexicon_categories": ["EFF-MED", "FMD-DIS", "EFF-BLD"]
                }
              ],
              "penalty_reference": "第一百四十条",
              "related_lexicon_categories": ["EFF", "FMD"]
            }
          ]
        }
      ],
      "penalty_summary": "违反第七十三条的，由县级以上人民政府食品安全监督管理部门没收违法所得，并处违法所得一倍以上五倍以下罚款。",
      "tags": ["食品安全法", "食品广告", "疾病治疗功能"],
      "version": "1.0.0",
      "created_at": "2026-07-30T00:00:00Z",
      "updated_at": "2026-07-30T00:00:00Z"
    },
    {
      "rule_id": "LAW-UC",
      "rule_type": "legal",
      "title": "中华人民共和国反不正当竞争法",
      "subtitle": "2019年修订版",
      "issuer": "全国人民代表大会常务委员会",
      "effective_date": "2019-04-23",
      "expire_date": null,
      "status": "effective",
      "source_url": "http://www.npc.gov.cn/",
      "chapters": [
        {
          "chapter_id": "ch02",
          "chapter_title": "第二章 不正当竞争行为",
          "sections": [
            {
              "section_id": "ch02-s08",
              "article_number": "第八条",
              "article_title": "虚假宣传禁止",
              "content": "经营者不得对其商品的性能、功能、质量、销售状况、用户评价、曾获荣誉等作虚假或者引人误解的商业宣传，欺骗、误导消费者。经营者不得通过组织虚假交易等方式，帮助其他经营者进行虚假或者引人误解的商业宣传。",
              "penalty_reference": "第二十条",
              "related_lexicon_categories": ["PLT-DAT", "PLT-QUA", "EJ"]
            },
            {
              "section_id": "ch02-s11",
              "article_number": "第十一条",
              "article_title": "商业诋毁禁止",
              "content": "经营者不得编造、传播虚假信息或者误导性信息，损害竞争对手的商业信誉、商品声誉。",
              "penalty_reference": "第二十三条",
              "related_lexicon_categories": ["EJ-CMP"]
            }
          ]
        }
      ],
      "penalty_summary": "违反第八条的，处二十万元以上一百万元以下的罚款；违反第十一条的，处十万元以上五十万元以下的罚款。",
      "tags": ["反不正当竞争法", "虚假宣传", "商业诋毁"],
      "version": "1.0.0",
      "created_at": "2026-07-30T00:00:00Z",
      "updated_at": "2026-07-30T00:00:00Z"
    },
    {
      "rule_id": "JD-694160650670313472",
      "rule_type": "platform",
      "title": "京东开放平台发布违规宣传信息细则",
      "subtitle": "京东平台核心规则",
      "issuer": "京东平台规则中心",
      "effective_date": "2026-04-08",
      "expire_date": null,
      "status": "effective",
      "source_url": "https://rule.jd.com/rule/ruleDetail.action?ruleId=694160650670313472",
      "chapters": [
        {
          "chapter_id": "ch01",
          "chapter_title": "违规宣传信息定义",
          "sections": [
            {
              "section_id": "ch01-s01",
              "article_number": "第一条",
              "article_title": "虚假宣传类型",
              "content": "商家在商品页面发布的以下信息构成违规宣传：(1)商品样式与实物不一致；(2)商品规格参数与实物不一致；(3)宣传包含特殊功效但实物未含有；(4)伪造授权证书、科研成果、排名信息；(5)使用广告法禁用词汇；(6)夸大商品功能功效；(7)过度美化商品不符合客观物理事实；(8)夸大服务承诺引发虚假宣传；(9)营销信息与实际不一致；(10)宣传京东/官方/旗舰店等与实际情况不一致。",
              "sub_items": [
                {
                  "item_id": "ch01-s01-i05",
                  "item_label": "(5)",
                  "content": "使用广告法禁用词汇",
                  "related_lexicon_categories": ["ADV"]
                },
                {
                  "item_id": "ch01-s01-i03",
                  "item_label": "(3)",
                  "content": "宣传包含特殊功效但实物未含有",
                  "related_lexicon_categories": ["EFF", "FMD"]
                },
                {
                  "item_id": "ch01-s01-i10",
                  "item_label": "(10)",
                  "content": "宣传京东/官方/旗舰店等与实际情况不一致（蹭京东官方）",
                  "related_lexicon_categories": ["PLT-TAG"]
                }
              ],
              "related_lexicon_categories": ["PLT", "FPM", "ADV", "EFF"]
            }
          ]
        }
      ],
      "penalty_summary": "违规宣传信息将根据严重程度进行M1-M7档位违约金处罚（100元-5000元以上），情节严重的可导致商品下架、店铺屏蔽、冻结钱包、清退等处罚。",
      "tags": ["京东规则", "虚假宣传", "广告法禁用词", "功效宣称", "标签滥用"],
      "version": "1.0.0",
      "created_at": "2026-07-30T00:00:00Z",
      "updated_at": "2026-07-30T00:00:00Z"
    },
    {
      "rule_id": "JD-selling-points",
      "rule_type": "platform",
      "title": "京东开放平台商品卖点管理规范",
      "issuer": "京东平台规则中心",
      "effective_date": "2024-01-01",
      "expire_date": null,
      "status": "effective",
      "source_url": "https://rule.jd.com/",
      "chapters": [
        {
          "chapter_id": "ch01",
          "chapter_title": "卖点发布规范",
          "sections": [
            {
              "section_id": "ch01-s01",
              "article_number": "第一条",
              "article_title": "卖点禁止内容",
              "content": "商品卖点中不得出现以下内容：(1)违禁词、绝对词、极限词等违反广告法的词汇；(2)营销广告类信息（批发、团购、代购等）；(3)平台客观数据（销量XX万、好评XX万+等）；(4)与商品无关的信息；(5)联系方式、二维码等导流信息；(6)其他平台名称。",
              "sub_items": [
                {
                  "item_id": "ch01-s01-i01",
                  "item_label": "(1)",
                  "content": "违禁词、绝对词、极限词",
                  "related_lexicon_categories": ["ADV-ABS", "ADV-EXT"]
                },
                {
                  "item_id": "ch01-s01-i02",
                  "item_label": "(2)",
                  "content": "营销广告类信息",
                  "related_lexicon_categories": ["PLT-MKT"]
                },
                {
                  "item_id": "ch01-s01-i03",
                  "item_label": "(3)",
                  "content": "平台客观数据",
                  "related_lexicon_categories": ["PLT-DAT"]
                },
                {
                  "item_id": "ch01-s01-i05",
                  "item_label": "(5)",
                  "content": "联系方式、二维码等导流信息",
                  "related_lexicon_categories": ["PLT-DIV"]
                }
              ],
              "related_lexicon_categories": ["PLT", "ADV"]
            }
          ]
        }
      ],
      "penalty_summary": "违反卖点管理规范的，将进行卖点删除并可能触发违规宣传信息处罚。",
      "tags": ["京东规则", "卖点管理", "营销违规", "导流违规"],
      "version": "1.0.0",
      "created_at": "2026-07-30T00:00:00Z",
      "updated_at": "2026-07-30T00:00:00Z"
    },
    {
      "rule_id": "LAW-COS-REG",
      "rule_type": "legal",
      "title": "化妆品监督管理条例",
      "subtitle": "2021年实施",
      "issuer": "国务院",
      "effective_date": "2021-01-01",
      "expire_date": null,
      "status": "effective",
      "source_url": "http://www.nmpa.gov.cn/",
      "chapters": [
        {
          "chapter_id": "ch03",
          "chapter_title": "第三章 化妆品广告",
          "sections": [
            {
              "section_id": "ch03-s43",
              "article_number": "第四十三条",
              "article_title": "化妆品广告规范",
              "content": "化妆品广告不得明示或者暗示产品具有医疗作用，不得含有虚假或者引人误解的内容，不得欺骗、误导消费者。",
              "related_lexicon_categories": ["EFF-BEA", "EFF-MED", "FMD"]
            }
          ]
        }
      ],
      "penalty_summary": "违反第四十三条的，处违法所得3倍以上5倍以下罚款。",
      "tags": ["化妆品监管", "医疗作用禁止"],
      "version": "1.0.0",
      "created_at": "2026-07-30T00:00:00Z",
      "updated_at": "2026-07-30T00:00:00Z"
    }
  ]
}
