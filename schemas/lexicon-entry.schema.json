{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "京东合规词库 - 词条结构定义",
  "description": "定义京东营销用语合规词库中每条违禁/敏感词条的标准数据结构",
  "type": "object",
  "required": [
    "id",
    "word",
    "category_l1",
    "category_l2",
    "risk_level",
    "word_type",
    "description",
    "applicable_categories",
    "detection_mode",
    "source",
    "status",
    "created_at",
    "updated_at",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(ADV|IND|PLT|FPM)-[A-Z]{3}-\\d{5}$",
      "description": "全局唯一ID，格式 {L1}-{L2}-{5位序号}，如 ADV-ABS-00001"
    },
    "word": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "违禁/敏感词汇原文"
    },
    "pinyin": {
      "type": "string",
      "description": "拼音（小写无空格），用于谐音变体检测"
    },
    "category_l1": {
      "type": "string",
      "enum": ["ADV", "IND", "PLT", "FPM"],
      "description": "一级分类码"
    },
    "category_l2": {
      "type": "string",
      "description": "二级分类码，如 ADV-ABS"
    },
    "category_l3": {
      "type": ["string", "null"],
      "description": "三级分类码（可选细分），如 ADV-ABS-PRICE"
    },
    "risk_level": {
      "type": "string",
      "enum": ["L1", "L2", "L3"],
      "description": "风险等级：L1=拦截级, L2=预警级, L3=提醒级"
    },
    "word_type": {
      "type": "string",
      "enum": ["word", "phrase", "pattern"],
      "description": "词汇类型：word=词, phrase=短语, pattern=正则模式"
    },
    "description": {
      "type": "string",
      "minLength": 5,
      "description": "违规说明，描述为何该词违规"
    },
    "legal_basis": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["law_name", "article", "content"],
        "properties": {
          "law_name": { "type": "string", "description": "法律/法规名称" },
          "article": { "type": "string", "description": "条款编号" },
          "content": { "type": "string", "description": "条款原文或摘要" },
          "source_url": { "type": "string", "description": "来源URL" }
        }
      },
      "description": "法律法规依据列表"
    },
    "platform_rule_basis": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_name", "clause"],
        "properties": {
          "rule_name": { "type": "string", "description": "京东规则名称" },
          "rule_id": { "type": "string", "description": "京东规则ID" },
          "clause": { "type": "string", "description": "对应条款/分类" },
          "source_url": { "type": "string", "description": "规则详情页URL" }
        }
      },
      "description": "京东平台规则依据列表"
    },
    "white_list_contexts": {
      "type": "array",
      "items": { "type": "string" },
      "description": "白名单上下文，列出该词可合法使用的场景"
    },
    "variants": {
      "type": "array",
      "items": { "type": "string" },
      "description": "变体列表（同义、谐音、拆字、扩展等）"
    },
    "variant_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["synonym", "homophone", "split", "extension", "abbreviation"]
      },
      "description": "变体类型列表，与variants一一对应"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "自由标签，用于多维交叉筛选"
    },
    "applicable_categories": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "适用商品类目列表，['all']表示全类目适用"
    },
    "exempt_categories": {
      "type": "array",
      "items": { "type": "string" },
      "description": "豁免类目列表（如医疗类目可使用部分医疗用语）"
    },
    "compliant_alternatives": {
      "type": "array",
      "items": { "type": "string" },
      "description": "合规替代词建议"
    },
    "detection_pattern": {
      "type": "string",
      "description": "正则表达式模式（用于复杂匹配场景）"
    },
    "detection_mode": {
      "type": "string",
      "enum": ["exact", "fuzzy", "regex", "semantic"],
      "description": "检测模式：exact=精确, fuzzy=模糊, regex=正则, semantic=语义"
    },
    "source": {
      "type": "object",
      "required": ["type", "name", "collected_date"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["official", "legal", "open_source", "manual", "third_party"],
          "description": "来源类型"
        },
        "name": { "type": "string", "description": "来源名称" },
        "url": { "type": "string", "description": "来源URL" },
        "collected_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "采集日期 (YYYY-MM-DD)"
        },
        "collected_by": { "type": "string", "description": "采集人/脚本" }
      },
      "description": "数据来源信息"
    },
    "status": {
      "type": "string",
      "enum": ["active", "deprecated", "draft", "review"],
      "description": "状态：active=启用, deprecated=已废弃, draft=草稿, review=审核中"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "创建时间（ISO 8601）"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "更新时间（ISO 8601）"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "词条版本号（语义化版本）"
    }
  }
}
